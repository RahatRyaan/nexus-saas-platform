# Root Environment Configuration Template
# Copy this file to .env and fill in your values

# --- Server Core ---
NODE_ENV=production
PORT=5000
CLIENT_URL=https://your-frontend.vercel.app

# --- Databases ---
# MongoDB Atlas (Cloud)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/nexus?retryWrites=true&w=majority

# Upstash Redis (Cloud)
REDIS_URL=rediss://default:<password>@<endpoint>.upstash.io:6379

# PostgreSQL + pgvector (Supabase or Neon)
POSTGRES_URL=postgresql://<username>:<password>@<endpoint>:5432/nexus_vectors

# --- Cryptographic JWT Secrets (min 32 chars) ---
JWT_ACCESS_SECRET=generate_random_32_chars_key_here
JWT_REFRESH_SECRET=generate_random_32_chars_key_here
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# --- Cloudinary (Media Storage) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- SSLCommerz (Payments) ---
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_SANDBOX=true

# --- AI Integration (OmniRoute / OpenAI / Gemini) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=auto

# --- Frontend (Vite) ---
VITE_API_URL=https://your-backend.onrender.com
VITE_SOCKET_URL=https://your-backend.onrender.com
